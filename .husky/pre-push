#!/usr/bin/env sh
set -e

remote="${1:-origin}"

main_sha=$(git ls-remote --heads "$remote" refs/heads/main 2>/dev/null | cut -f1)
if [ -z "$main_sha" ]; then
  exit 0
fi

if ! git cat-file -e "$main_sha^{commit}" 2>/dev/null; then
  git fetch --quiet "$remote" main || {
    echo "pre-push: could not fetch $remote main." >&2
    exit 1
  }
fi

behind=""
if [ -t 0 ]; then
  if ! git merge-base --is-ancestor "$main_sha" HEAD 2>/dev/null; then
    behind=" HEAD"
  fi
else
  while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
      refs/heads/*) ;;
      *) continue ;;
    esac
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
      continue
    fi
    if ! git merge-base --is-ancestor "$main_sha" "$local_sha" 2>/dev/null; then
      behind="$behind $remote_ref"
    fi
  done
fi

if [ -n "$behind" ]; then
  echo "pre-push: these refs do not contain $remote/main ($main_sha):$behind" >&2
  echo "Merge or rebase $remote/main before pushing." >&2
  exit 1
fi
