{
  "name": "@systemfsoftware/stryker-js-angular",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/stryker-js-effect.git",
    "directory": "packages/frameworks/angular"
  },
  "homepage": "https://github.com/systemfsoftware/stryker-js-effect/tree/main/packages/frameworks/angular#readme",
  "bugs": {
    "url": "https://github.com/systemfsoftware/stryker-js-effect/issues"
  },
  "description": "Stryker framework plugin for Angular and Vue templates: claims .html, .htm, and .vue files and instruments their embedded script regions, never template expressions.",
  "keywords": [
    "stryker",
    "stryker-mutator",
    "mutation-testing",
    "angular",
    "vue",
    "html",
    "framework",
    "plugin"
  ],
  "type": "module",
  "strykerFramework": {
    "extensions": [
      ".html",
      ".htm",
      ".vue"
    ]
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "lint:tsgo": "effect-tsgo diagnostics --project tsconfig.app.json --format ${TSGO_FORMAT:-text} && effect-tsgo diagnostics --project tsconfig.test.json --format ${TSGO_FORMAT:-text}"
  },
  "dependencies": {
    "@systemfsoftware/stryker-framework-interface": "workspace:^",
    "angular-html-parser": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/oxlint-ignorer-config": "workspace:^",
    "@systemfsoftware/tsconfig": "catalog:",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest": "catalog:",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxc-parser": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
