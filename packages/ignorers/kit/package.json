{
  "name": "@systemfsoftware/stryker-ignorer-kit",
  "license": "Apache-2.0",
  "version": "0.1.1",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/stryker-js-effect.git",
    "directory": "packages/ignorers/kit"
  },
  "homepage": "https://github.com/systemfsoftware/stryker-js-effect/tree/main/packages/ignorers/kit#readme",
  "bugs": {
    "url": "https://github.com/systemfsoftware/stryker-js-effect/issues"
  },
  "description": "Authoring and testing kit for Stryker ignorers — typed visitors compiled to the Ignorer wire contract, and a RuleTester-shaped harness that verifies them from source snippets.",
  "keywords": [
    "stryker",
    "stryker-mutator",
    "mutation-testing",
    "ignorer",
    "testing"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tester": {
      "@systemfsoftware/source": "./src/tester/mod.ts",
      "types": "./dist/tester.d.ts",
      "default": "./dist/tester.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "concurrently --kill-others-on-fail \"api-extractor run\" \"api-extractor run --config api-extractor.tester.json\"",
    "api:update": "concurrently --kill-others-on-fail \"api-extractor run --local\" \"api-extractor run --local --config api-extractor.tester.json\""
  },
  "dependencies": {
    "@oxc-project/types": "catalog:",
    "@systemfsoftware/stryker-ignorer-interface": "workspace:^",
    "oxc-parser": "catalog:",
    "oxc-walker": "catalog:"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/oxlint-ignorer-config": "workspace:^",
    "@systemfsoftware/tsconfig": "catalog:",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest": "catalog:",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./tester": {
        "types": "./dist/tester.d.ts",
        "default": "./dist/tester.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
