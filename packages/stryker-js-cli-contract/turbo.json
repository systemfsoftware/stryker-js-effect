{
  "$schema": "https://v2-10-1.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/.changeset/**",
        "$TURBO_ROOT$/test/*/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/toolchain/*/package.json",
        "$TURBO_ROOT$/packages/ignorers/*/package.json",
        "$TURBO_ROOT$/packages/frameworks/*/package.json",
        "$TURBO_ROOT$/packages/stryker-js-plugin-interface/contract/**"
      ],
      "cache": false
    }
  }
}
