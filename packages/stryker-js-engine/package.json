{
  "name": "@systemfsoftware/stryker-js-engine",
  "version": "5.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/stryker-js-effect.git",
    "directory": "packages/stryker-js-engine"
  },
  "homepage": "https://github.com/systemfsoftware/stryker-js-effect/tree/main/packages/stryker-js-engine#readme",
  "bugs": "https://github.com/systemfsoftware/stryker-js-effect/issues",
  "description": "The Stryker run engine as an Effect library - Engine, Worker, Plugin and the rest of the host API, on the effect instance of the project that embeds it.",
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run typecheck && tsdown",
    "typecheck": "tsc -b",
    "attw": "attw --pack .",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.13.1"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@noble/hashes": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@systemfsoftware/effect-cell-types": "catalog:",
    "@systemfsoftware/stryker-framework-interface": "workspace:^",
    "@systemfsoftware/stryker-ignorer-interface": "workspace:^",
    "@systemfsoftware/stryker-js-cli-contract": "workspace:^",
    "@systemfsoftware/stryker-js-html-reporter": "workspace:^",
    "@systemfsoftware/stryker-js-instrumenter": "workspace:^",
    "@systemfsoftware/stryker-js-plugin-interface": "workspace:^",
    "@systemfsoftware/stryker-js-plugin-runtime": "workspace:^",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/oxlint-config-recommended": "catalog:",
    "@systemfsoftware/stryker-js": "workspace:^",
    "@systemfsoftware/tsconfig": "catalog:",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./../stryker-js/src/mod.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "inlinedDependencies": {
    "@jsr/std__jsonc": "1.0.2",
    "oxc-parser": "0.150.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
