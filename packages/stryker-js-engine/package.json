{
  "name": "@systemfsoftware/stryker-js-engine",
  "version": "4.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/stryker-js-effect.git",
    "directory": "packages/stryker-js-engine"
  },
  "homepage": "https://github.com/systemfsoftware/stryker-js-effect",
  "bugs": {
    "url": "https://github.com/systemfsoftware/stryker-js-effect/issues"
  },
  "description": "The host-neutral mutation engine — the run, its stages, and the ports a process entry binds to start it.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --incremental && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "build": "tsdown",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "concurrently --kill-others-on-fail \"api-extractor run\" \"api-extractor run --config api-extractor.builtin-reporters.json\" \"api-extractor run --config api-extractor.base.json\" \"api-extractor run --config api-extractor.plugin-loader.json\" \"api-extractor run --config api-extractor.worker.json\"",
    "api:update": "concurrently --kill-others-on-fail \"api-extractor run --local\" \"api-extractor run --local --config api-extractor.builtin-reporters.json\" \"api-extractor run --local --config api-extractor.base.json\" \"api-extractor run --local --config api-extractor.plugin-loader.json\" \"api-extractor run --local --config api-extractor.worker.json\""
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "@opentelemetry/api": "^1.9.0",
    "@systemfsoftware/effect-cell-types": "catalog:",
    "@systemfsoftware/stryker-ignorer-interface": "workspace:^",
    "@systemfsoftware/stryker-js-instrumenter": "workspace:^",
    "@systemfsoftware/stryker-js-language": "workspace:^",
    "@systemfsoftware/stryker-js-plugin-interface": "workspace:^",
    "diff-match-patch": "1.0.5",
    "minimatch": "~10.2.4"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@std/jsonc": "catalog:",
    "@systemfsoftware/all": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/diff-match-patch": "1.0.36",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.mjs",
      "./builtin-reporters": "./dist/builtin-reporters.mjs",
      "./plugin-loader": "./dist/plugin-loader.mjs",
      "./config/base": "./dist/config/base.mjs",
      "./worker": "./dist/worker.mjs",
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./builtin-reporters": "./dist/builtin-reporters.mjs",
    "./config/base": "./dist/config/base.mjs",
    "./plugin-loader": "./dist/plugin-loader.mjs",
    "./worker": "./dist/worker.mjs",
    "./package.json": "./package.json"
  },
  "inlinedDependencies": {
    "@jsr/std__jsonc": "1.0.2"
  }
}
