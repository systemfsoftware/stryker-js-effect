{
  "extends": "@systemfsoftware/tsconfig/tsc/no-dom/library",
  "compilerOptions": {
    "customConditions": ["@systemfsoftware/source"],
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  "include": [
    "src",
    "test",
    "tests"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
