{
  "name": "@systemfsoftware/stryker-js-language",
  "version": "4.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/stryker-js-effect.git",
    "directory": "packages/stryker-js-language"
  },
  "homepage": "https://github.com/systemfsoftware/stryker-js-effect/tree/main/packages/stryker-js-language#readme",
  "bugs": "https://github.com/systemfsoftware/stryker-js-effect/issues",
  "description": "The mutation-testing language — concept modules, no platform.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown && pnpm api:check",
    "typecheck": "tsc --noEmit --incremental && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "attw": "attw --pack .",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "api:check": "tsdown && api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@systemfsoftware/effect-cell-types": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/all": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-schema-law": "catalog:",
    "@systemfsoftware/effect-schema-vite": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.mjs",
      "./Checker": "./dist/Checker.mjs",
      "./Evaluator": "./dist/Evaluator.mjs",
      "./ExitClass": "./dist/ExitClass.mjs",
      "./Ignorer": "./dist/Ignorer.mjs",
      "./Metrics": "./dist/Metrics.mjs",
      "./Module": "./dist/Module.mjs",
      "./Mutant": "./dist/Mutant.mjs",
      "./output-file": "./dist/output-file.mjs",
      "./provided-options": "./dist/provided-options.mjs",
      "./Report": "./dist/Report.mjs",
      "./Reporter": "./dist/Reporter.mjs",
      "./ReporterEvent": "./dist/ReporterEvent.mjs",
      "./Run": "./dist/Run.mjs",
      "./Schema": "./dist/Schema.mjs",
      "./TestRunner": "./dist/TestRunner.mjs",
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  }
}
