{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/tsc/no-dom/library",
    "@systemfsoftware/tsconfig/effect"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.app.tsbuildinfo",
    "outDir": "node_modules/.cache/tsc/app",
    "customConditions": [
      "@systemfsoftware/source"
    ],
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitOverride": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect/FileSystem",
          "effect/Path",
          "effect/PlatformError",
          "effect/http/Headers",
          "effect/net/NetAddress",
          "effect/rpc/Rpc",
          "effect/rpc/RpcGroup",
          "effect/rpc/RpcMessage",
          "effect/rpc/RpcMiddleware",
          "effect/rpc/RpcSerialization",
          "effect/rpc/RpcServer",
          "effect/socket/SocketServer"
        ]
      }
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.ts"
  ]
}
