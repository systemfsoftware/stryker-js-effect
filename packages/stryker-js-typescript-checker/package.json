{
  "name": "@systemfsoftware/stryker-js-typescript-checker",
  "version": "8.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/stryker-js-effect.git",
    "directory": "packages/stryker-js-typescript-checker"
  },
  "homepage": "https://github.com/systemfsoftware/stryker-js-effect",
  "bugs": "https://github.com/systemfsoftware/stryker-js-effect/issues",
  "description": "TypeScript checker plugin for Stryker — TS7 native",
  "type": "module",
  "files": [
    "dist",
    "schema",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./runtime": {
      "@systemfsoftware/source": "./src/runtime/mod.ts",
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc -b",
    "attw": "attw --pack .",
    "test": "vitest run",
    "mutation": "stryker run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "lint:tsgo": "effect-tsgo diagnostics --project tsconfig.app.json --format ${TSGO_FORMAT:-text} && effect-tsgo diagnostics --project tsconfig.test.json --format ${TSGO_FORMAT:-text}"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@effect/opentelemetry": "catalog:",
    "@noble/hashes": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@systemfsoftware/effect-cell-types": "catalog:",
    "@systemfsoftware/stryker-js-cli-contract": "workspace:^",
    "@systemfsoftware/stryker-js-instrumenter": "workspace:^",
    "@systemfsoftware/stryker-js-plugin-interface": "workspace:^",
    "@systemfsoftware/stryker-js-plugin-runtime": "workspace:^",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/tsgo": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@std/jsonc": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "catalog:",
    "@systemfsoftware/effect-schema-law": "catalog:",
    "@systemfsoftware/oxlint-config-recommended": "catalog:",
    "@systemfsoftware/stryker-config": "workspace:^",
    "@systemfsoftware/stryker-ignorer-effect-schema-declarations": "file:../../.sfs-deps/stryker-ignorer-effect-schema-declarations.tgz",
    "@systemfsoftware/stryker-ignorer-in-source-vitest-block": "file:../../.sfs-deps/stryker-ignorer-in-source-vitest-block.tgz",
    "@systemfsoftware/stryker-js": "file:../../.sfs-deps/stryker-js.tgz",
    "@systemfsoftware/stryker-js-typescript-checker": "file:../../.sfs-deps/stryker-js-typescript-checker.tgz",
    "@systemfsoftware/stryker-js-vitest-runner": "file:../../.sfs-deps/stryker-js-vitest-runner.tgz",
    "@systemfsoftware/tsconfig": "catalog:",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest": "catalog:",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "inlinedDependencies": {
    "@effect/opentelemetry": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@eslint-community/regexpp": "4.12.2",
    "@jsr/std__jsonc": "1.0.2",
    "@noble/hashes": "2.4.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/otlp-exporter-base": "0.222.0",
    "@opentelemetry/otlp-transformer": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@systemfsoftware/effect-cell-types": "12.0.0",
    "effect": "4.0.0",
    "oxc-parser": "0.150.0",
    "ws": "8.22.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./runtime": {
        "types": "./dist/runtime.d.mts",
        "default": "./dist/runtime.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
