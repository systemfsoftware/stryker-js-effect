{
  "name": "@systemfsoftware/stryker-js-typescript-checker",
  "version": "7.0.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/stryker-js-effect.git",
    "directory": "packages/stryker-js-typescript-checker"
  },
  "homepage": "https://github.com/systemfsoftware/stryker-js-effect",
  "bugs": "https://github.com/systemfsoftware/stryker-js-effect/issues",
  "description": "TypeScript checker plugin for Stryker — TS7 native",
  "type": "module",
  "files": [
    "dist",
    "schema"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc -b",
    "attw": "attw --pack .",
    "test": "vitest run",
    "mutation": "stryker run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "lint:tsgo": "effect-tsgo diagnostics --project tsconfig.app.json --format ${TSGO_FORMAT:-text} && effect-tsgo diagnostics --project tsconfig.test.json --format ${TSGO_FORMAT:-text}"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@effect/opentelemetry": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@systemfsoftware/effect-cell-types": "catalog:",
    "@systemfsoftware/stryker-js-instrumenter": "workspace:^",
    "@systemfsoftware/stryker-js-plugin-interface": "workspace:^",
    "@systemfsoftware/stryker-js-plugin-runtime": "workspace:^",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@std/jsonc": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "catalog:",
    "@systemfsoftware/effect-schema-law": "catalog:",
    "@systemfsoftware/effect-schema-vite": "catalog:",
    "@systemfsoftware/oxlint-config-recommended": "catalog:",
    "@systemfsoftware/stryker-config": "workspace:^",
    "@systemfsoftware/stryker-ignorer-effect-schema-declarations": "catalog:stryker",
    "@systemfsoftware/stryker-ignorer-in-source-vitest-block": "catalog:stryker",
    "@systemfsoftware/stryker-js": "catalog:stryker",
    "@systemfsoftware/stryker-js-typescript-checker": "catalog:stryker",
    "@systemfsoftware/stryker-js-vitest-runner": "catalog:stryker",
    "@systemfsoftware/stryker-test-contribution": "catalog:stryker",
    "@systemfsoftware/tsconfig": "catalog:",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "inlinedDependencies": {
    "@effect/opentelemetry": "4.0.0-rc.117",
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/platform-node-shared": "4.0.0-rc.117",
    "@eslint-community/regexpp": "4.12.2",
    "@jridgewell/gen-mapping": "0.3.13",
    "@jridgewell/remapping": "2.3.5",
    "@jridgewell/resolve-uri": "3.1.2",
    "@jridgewell/sourcemap-codec": "1.6.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@jsr/std__jsonc": "1.0.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "2.11.0",
