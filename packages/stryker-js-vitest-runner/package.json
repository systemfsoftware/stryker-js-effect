{
  "name": "@systemfsoftware/stryker-js-vitest-runner",
  "version": "4.0.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/stryker-js-effect.git",
    "directory": "packages/stryker-js-vitest-runner"
  },
  "homepage": "https://github.com/systemfsoftware/stryker-js-effect",
  "bugs": "https://github.com/systemfsoftware/stryker-js-effect/issues",
  "description": "Vitest test-runner plugin for Stryker",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "default": "./dist/index.mjs",
      "@systemfsoftware/source": "./src/index.ts",
      "types": "./dist/index.d.mts"
    },
    "./stryker-setup": {
      "default": "./dist/stryker-setup.mjs",
      "@systemfsoftware/source": "./src/stryker-setup.ts",
      "types": "./dist/stryker-setup.d.mts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit --incremental && tsc -p tsconfig.node.json --noEmit",
    "attw": "attw --pack .",
    "test": "vitest run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "api:check": "concurrently --kill-others-on-fail \"api-extractor run\" \"api-extractor run --config api-extractor.stryker-setup.json\"",
    "api:update": "concurrently --kill-others-on-fail \"api-extractor run --local\" \"api-extractor run --local --config api-extractor.stryker-setup.json\""
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "stryker",
    "vitest",
    "@systemfsoftware/stryker-js-test-runner-plugin"
  ],
  "initStrykerConfig": {
    "coverageAnalysis": "perTest"
  },
  "dependencies": {
    "@systemfsoftware/effect-cell-types": "catalog:",
    "@systemfsoftware/stryker-js-language": "workspace:^",
    "@systemfsoftware/stryker-js-plugin-interface": "workspace:^"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "vitest": ">=2.0.0"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/all": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "concurrently": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./stryker-setup": {
        "types": "./dist/stryker-setup.d.mts",
        "default": "./dist/stryker-setup.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
