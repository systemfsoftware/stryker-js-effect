{
  "name": "@systemfsoftware/stryker-js-vitest-runner",
  "version": "7.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/stryker-js-effect.git",
    "directory": "packages/stryker-js-vitest-runner"
  },
  "homepage": "https://github.com/systemfsoftware/stryker-js-effect",
  "bugs": "https://github.com/systemfsoftware/stryker-js-effect/issues",
  "description": "Vitest test-runner plugin for Stryker",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit --incremental && tsc -p tsconfig.node.json --noEmit",
    "attw": "attw --pack .",
    "test": "vitest run",
    "mutation": "stryker run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "stryker",
    "vitest",
    "@systemfsoftware/stryker-js-test-runner-plugin"
  ],
  "initStrykerConfig": {
    "coverageAnalysis": "perTest"
  },
  "dependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@systemfsoftware/effect-cell-types": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "vitest": ">=4.1.0"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/all": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "catalog:",
    "@systemfsoftware/stryker-config": "workspace:^",
    "@systemfsoftware/stryker-ignorer-effect-schema-declarations": "catalog:stryker",
    "@systemfsoftware/stryker-ignorer-in-source-vitest-block": "catalog:stryker",
    "@systemfsoftware/stryker-js": "catalog:stryker",
    "@systemfsoftware/stryker-js-instrumenter": "workspace:^",
    "@systemfsoftware/stryker-js-plugin-interface": "workspace:^",
    "@systemfsoftware/stryker-js-plugin-runtime": "workspace:^",
    "@systemfsoftware/stryker-js-typescript-checker": "catalog:stryker",
    "@systemfsoftware/stryker-js-vitest-runner": "catalog:stryker",
    "@systemfsoftware/stryker-test-contribution": "catalog:stryker",
    "@systemfsoftware/tsconfig": "catalog:",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "concurrently": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "inlinedDependencies": {
    "@effect/opentelemetry": "4.0.0-rc.116",
    "@effect/platform-node": "4.0.0-rc.116",
    "@effect/platform-node-shared": "4.0.0-rc.116",
    "@eslint-community/regexpp": "4.12.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.208.0",
    "@opentelemetry/context-async-hooks": "2.2.0",
    "@opentelemetry/core": [
      "2.11.0",
      "2.2.0"
    ],
    "@opentelemetry/exporter-trace-otlp-http": "0.208.0",
    "@opentelemetry/otlp-exporter-base": "0.208.0",
    "@opentelemetry/otlp-transformer": "0.208.0",
    "@opentelemetry/resources": [
      "2.11.0",
      "2.2.0"
    ],
    "@opentelemetry/sdk-logs": "0.208.0",
    "@opentelemetry/sdk-metrics": "2.2.0",
    "@opentelemetry/sdk-trace": "2.11.0",
    "@opentelemetry/sdk-trace-base": [
      "2.11.0",
      "2.2.0"
    ],
    "@opentelemetry/sdk-trace-node": "2.2.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@protobufjs/aspromise": "1.1.2",
    "@protobufjs/base64": "1.1.2",
    "@protobufjs/eventemitter": "1.1.1",
    "@protobufjs/float": "1.0.2",
    "@protobufjs/pool": "1.1.0",
    "@protobufjs/utf8": "1.1.2",
    "@systemfsoftware/effect-cell-types": "8.3.1",
    "effect": "4.0.0-rc.116",
    "long": "5.3.2",
    "oxc-parser": "0.150.0",
    "protobufjs": "7.6.6",
    "ws": "8.21.3"
  }
}
