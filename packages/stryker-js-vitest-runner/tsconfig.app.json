{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@systemfsoftware/tsconfig/tsc/no-dom/library",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.app.tsbuildinfo",
    "outDir": "node_modules/.cache/tsc/app",
    "customConditions": [
      "@systemfsoftware/source"
    ],
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitOverride": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/opentelemetry/NodeSdk",
          "@effect/platform-node-shared/NodeCrypto",
          "@effect/platform-node-shared/NodeSocketServer",
          "@effect/platform-node/NodeFileSystem",
          "@effect/platform-node/NodePath",
          "@effect/platform-node/NodeRuntime",
          "effect/FileSystem",
          "effect/Path",
          "effect/crypto/SecureRandom"
        ]
      }
    ]
  },
  "include": [
    "sandbox",
    "src",
    "typings"
  ],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "testResources"
  ]
}
