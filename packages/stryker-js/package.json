{
  "name": "@systemfsoftware/stryker-js",
  "version": "20.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/stryker-js-effect.git",
    "directory": "packages/stryker-js"
  },
  "homepage": "https://github.com/systemfsoftware/stryker-js-effect",
  "bugs": {
    "url": "https://github.com/systemfsoftware/stryker-js-effect/issues"
  },
  "description": "The Stryker mutation testing tool — the stryker executable and the configuration surface.",
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "bin": {
    "stryker": "./dist/main.mjs"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run typecheck && tsdown",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "fixtures:lockfile-oracle": "./scripts/lockfile-oracle.sh",
    "mutation": "stryker run",
    "attw": "attw --pack .",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "lint:tsgo": "effect-tsgo diagnostics --project tsconfig.app.json --format ${TSGO_FORMAT:-text} && effect-tsgo diagnostics --project tsconfig.test.json --format ${TSGO_FORMAT:-text}"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.13.1"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@systemfsoftware/stryker-js-vm-runner": "workspace:@systemfsoftware/stryker-js-vitest-runner@^"
  },
  "devDependencies": {
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/tsgo": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@oxc-parser/binding-wasm32-wasi": "catalog:",
    "@std/jsonc": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/differential-spec": "catalog:",
    "@systemfsoftware/effect-cell-types": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "catalog:",
    "@systemfsoftware/effect-schema-law": "catalog:",
    "@systemfsoftware/oxlint-config-recommended": "catalog:",
    "@systemfsoftware/stryker-config": "workspace:^",
    "@systemfsoftware/stryker-framework-interface": "workspace:^",
    "@systemfsoftware/stryker-ignorer-effect-schema-declarations": "file:../../.sfs-deps/stryker-ignorer-effect-schema-declarations.tgz",
    "@systemfsoftware/stryker-ignorer-in-source-vitest-block": "file:../../.sfs-deps/stryker-ignorer-in-source-vitest-block.tgz",
    "@systemfsoftware/stryker-ignorer-interface": "workspace:^",
    "@systemfsoftware/stryker-js": "file:../../.sfs-deps/stryker-js.tgz",
    "@systemfsoftware/stryker-js-cli-contract": "workspace:^",
    "@systemfsoftware/stryker-js-html-reporter": "workspace:^",
    "@systemfsoftware/stryker-js-instrumenter": "workspace:^",
    "@systemfsoftware/stryker-js-plugin-interface": "workspace:^",
    "@systemfsoftware/stryker-js-plugin-runtime": "workspace:^",
    "@systemfsoftware/stryker-js-typescript-checker": "file:../../.sfs-deps/stryker-js-typescript-checker.tgz",
    "@systemfsoftware/stryker-js-vitest-runner": "file:../../.sfs-deps/stryker-js-vitest-runner.tgz",
    "@systemfsoftware/tsconfig": "catalog:",
    "@systemfsoftware/tsdown-config": "workspace:^",
    "@systemfsoftware/vitest": "catalog:",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "happy-dom": "catalog:",
    "jsdom": "catalog:",
    "mutation-testing-elements": "catalog:stryker",
    "oxc-parser": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./config": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      },
      "./events": {
        "types": "./dist/events.d.mts",
        "default": "./dist/events.mjs"
      },
      "./promises": {
        "types": "./dist/promises.d.mts",
        "default": "./dist/promises.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts"
    },
    "./config": {
      "@systemfsoftware/source": "./src/config/mod.ts",
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    },
    "./events": {
      "@systemfsoftware/source": "./src/events/mod.ts",
      "types": "./dist/events.d.mts",
      "default": "./dist/events.mjs"
    },
    "./promises": {
      "@systemfsoftware/source": "./src/promises/mod.ts",
      "types": "./dist/promises.d.mts",
      "default": "./dist/promises.mjs"
    },
    "./package.json": "./package.json"
  },
  "inlinedDependencies": {
    "@effect/platform-node": "4.1.0",
    "@effect/platform-node-shared": "4.1.0",
    "@eslint-community/regexpp": "4.12.2",
    "@jsr/std__jsonc": "1.0.2",
    "@systemfsoftware/effect-cell-types": "12.0.0",
    "effect": "4.1.0",
    "oxc-parser": "0.150.0",
    "yaml": "2.9.1"
  }
}
