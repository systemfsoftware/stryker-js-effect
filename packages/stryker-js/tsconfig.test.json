{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/tsc/no-dom/library",
    "@systemfsoftware/tsconfig/effect/entrypoint"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.test.tsbuildinfo",
    "outDir": "node_modules/.cache/tsc/test",
    "customConditions": [
      "@systemfsoftware/source"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/opentelemetry/NodeSdk",
          "@effect/opentelemetry/OtelTracer",
          "@effect/platform-node-shared/NodeChildProcessSpawner",
          "@effect/platform-node-shared/NodeCrypto",
          "@effect/platform-node-shared/NodeSocket",
          "@effect/platform-node-shared/NodeSocketServer",
          "@effect/platform-node/NodeFileSystem",
          "@effect/platform-node/NodePath",
          "@effect/platform-node/NodeRuntime",
          "@effect/platform-node/NodeServices",
          "@effect/platform-node/NodeStdio",
          "@effect/platform-node/NodeTerminal",
          "effect/Arbitrary",
          "effect/FileSystem",
          "effect/Path",
          "effect/PlatformError",
          "effect/Stdio",
          "effect/ai/McpProtocol",
          "effect/ai/McpServer",
          "effect/ai/Tool",
          "effect/ai/Toolkit",
          "effect/cli/Argument",
          "effect/cli/CliConfig",
          "effect/cli/CliError",
          "effect/cli/Command",
          "effect/cli/Flag",
          "effect/cli/GlobalFlag",
          "effect/crypto/SecureRandom",
          "effect/http/Headers",
          "effect/net/NetAddress",
          "effect/process/ChildProcess",
          "effect/process/ChildProcessSpawner",
          "effect/rpc/Rpc",
          "effect/rpc/RpcClient",
          "effect/rpc/RpcClientError",
          "effect/rpc/RpcGroup",
          "effect/rpc/RpcMessage",
          "effect/rpc/RpcSerialization",
          "effect/rpc/RpcServer",
          "effect/socket/Socket",
          "effect/socket/SocketServer"
        ]
      }
    ]
  },
  "include": [
    "tests",
    "src/**/__tests__",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
