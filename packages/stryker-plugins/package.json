{
  "name": "@systemfsoftware/stryker-plugins",
  "license": "Apache-2.0",
  "version": "3.1.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/stryker-js-effect.git",
    "directory": "packages/stryker-plugins"
  },
  "homepage": "https://github.com/systemfsoftware/stryker-js-effect/tree/main/packages/stryker-plugins#readme",
  "bugs": "https://github.com/systemfsoftware/stryker-js-effect/issues",
  "description": "Stryker mutation-testing plugins for Effect-TS — ignore equivalent mutants on Effect Schema declarations (brands, TaggedClass/TaggedError tags) so the score reflects behaviour, not data.",
  "keywords": [
    "stryker",
    "stryker-mutator",
    "mutation-testing",
    "effect",
    "effect-ts",
    "schema",
    "ignorer",
    "equivalent-mutants",
    "test-quality",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./effect-schema-ignorer": {
      "types": "./dist/effect-schema-ignorer.d.ts",
      "default": "./dist/effect-schema-ignorer.mjs"
    },
    "./in-source-test-ignorer": {
      "types": "./dist/in-source-test-ignorer.d.ts",
      "default": "./dist/in-source-test-ignorer.mjs"
    },
    "./workflow-make-ignorer": {
      "types": "./dist/workflow-make-ignorer.d.ts",
      "default": "./dist/workflow-make-ignorer.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@systemfsoftware/all": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "catalog:",
    "@systemfsoftware/effect-schema-law": "catalog:",
    "@systemfsoftware/effect-schema-vite": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@systemfsoftware/stryker-js": "workspace:^",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/estree": "1.0.8",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@systemfsoftware/stryker-js": "workspace:^",
    "effect": "catalog:",
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./effect-schema-ignorer": {
        "types": "./dist/effect-schema-ignorer.d.ts",
        "default": "./dist/effect-schema-ignorer.mjs"
      },
      "./in-source-test-ignorer": {
        "types": "./dist/in-source-test-ignorer.d.ts",
        "default": "./dist/in-source-test-ignorer.mjs"
      },
      "./workflow-make-ignorer": {
        "types": "./dist/workflow-make-ignorer.d.ts",
        "default": "./dist/workflow-make-ignorer.mjs"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
