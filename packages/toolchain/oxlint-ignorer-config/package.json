{
  "name": "@systemfsoftware/oxlint-ignorer-config",
  "version": "0.0.0",
  "description": "The lint preset for an ignorer package: one path per decision, no casts on foreign data, and no StrykerJS runtime behind an ignorer",
  "keywords": [
    "oxlint",
    "oxlint-config",
    "stryker",
    "ignorer"
  ],
  "license": "Apache-2.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "type": "module",
  "module": "./lib/base.js",
  "files": [
    "lib"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./lib/base.d.ts",
        "default": "./lib/base.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/stryker-js-effect.git",
    "directory": "packages/toolchain/oxlint-ignorer-config"
  },
  "homepage": "https://github.com/systemfsoftware/stryker-js-effect/tree/main/packages/toolchain/oxlint-ignorer-config#readme",
  "bugs": "https://github.com/systemfsoftware/stryker-js-effect/issues",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./lib/base.d.ts",
          "default": "./lib/base.js"
        }
      }
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:"
  }
}
