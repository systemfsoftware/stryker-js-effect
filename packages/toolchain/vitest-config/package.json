{
  "name": "@systemfsoftware/vitest-config",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "type": "module",
  "module": "./lib/base.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./lib/base.d.ts",
        "default": "./lib/base.js"
      }
    },
    "./schema-laws": {
      "import": {
        "types": "./lib/schema-laws.d.ts",
        "default": "./lib/schema-laws.js"
      }
    },
    "./telemetry": {
      "import": {
        "types": "./lib/telemetry.d.ts",
        "default": "./lib/telemetry.js"
      }
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint:tsgo": "effect-tsgo diagnostics --project tsconfig.app.json --format ${TSGO_FORMAT:-text} && effect-tsgo diagnostics --project tsconfig.test.json --format ${TSGO_FORMAT:-text}"
  },
  "devDependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@systemfsoftware/effect-schema-discovery": "catalog:",
    "@systemfsoftware/effect-schema-law": "catalog:",
    "@systemfsoftware/effect-schema-recursion-budget": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@systemfsoftware/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/stryker-js-effect.git",
    "directory": "packages/toolchain/vitest-config"
  },
  "homepage": "https://github.com/systemfsoftware/stryker-js-effect/tree/main/packages/toolchain/vitest-config#readme"
}
