{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/tsc/dom/library-monorepo"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsc/app",
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.app.tsbuildinfo",
    "allowJs": true,
    "checkJs": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect/http/FetchHttpClient",
          "effect/observability/OtlpExporter",
          "effect/observability/OtlpSerialization",
          "effect/observability/OtlpTracer"
        ]
      }
    ]
  },
  "include": [
    "lib"
  ]
}
