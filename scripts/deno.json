{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "types": ["vitest/importMeta"]
  },
  "unstable": ["sloppy-imports"],
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["npm:effect"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/async/pool": "jsr:@std/async@1/pool",
    "@std/cli/parse-args": "jsr:@std/cli@1/parse-args",
    "@std/collections/without-all": "jsr:@std/collections@1/without-all",
    "@std/encoding/base64": "jsr:@std/encoding@1/base64",
    "@std/encoding/hex": "jsr:@std/encoding@1/hex",
    "@std/front-matter": "jsr:@std/front-matter@1",
    "@std/fs/ensure-dir": "jsr:@std/fs@1/ensure-dir",
    "@std/fs/expand-glob": "jsr:@std/fs@1/expand-glob",
    "@std/path": "jsr:@std/path@1",
    "@std/yaml": "jsr:@std/yaml@1",
    "@systemfsoftware/vitest": "npm:@systemfsoftware/vitest@^1.0.0",
    "vitest": "npm:vitest@^5",
    "effect": "npm:effect@^4.0.0",
    "octokit": "npm:octokit@^4"
  }
}
