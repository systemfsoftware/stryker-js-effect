{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/tsc/no-dom/library",
    "@systemfsoftware/tsconfig/effect/entrypoint"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.test.tsbuildinfo",
    "outDir": "node_modules/.cache/tsc/test",
    "customConditions": [
      "@systemfsoftware/source"
    ],
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitOverride": false,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node-shared/NodeCrypto",
          "@effect/platform-node/NodeRuntime",
          "@effect/platform-node/NodeServices",
          "effect/Arbitrary",
          "effect/FileSystem",
          "effect/Path",
          "effect/PlatformError",
          "effect/crypto/Digest",
          "effect/process/ChildProcess",
          "effect/process/ChildProcessSpawner"
        ]
      }
    ]
  },
  "include": [
    "src/**/__tests__/**/*",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
