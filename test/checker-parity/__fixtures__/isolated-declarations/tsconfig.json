{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "isolatedDeclarations": true,
    "declaration": true,
    "noEmit": true,
    "types": [],
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}
