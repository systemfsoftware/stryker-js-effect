{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/tsc/no-dom/library",
    "@systemfsoftware/tsconfig/effect/entrypoint"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.test.tsbuildinfo",
    "outDir": "node_modules/.cache/tsc/test",
    "customConditions": [
      "@systemfsoftware/source"
    ],
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/opentelemetry/NodeSdk",
          "@effect/platform-node-shared/NodeChildProcessSpawner",
          "@effect/platform-node/NodeFileSystem",
          "@effect/platform-node/NodeHttpServer",
          "@effect/platform-node/NodePath",
          "@effect/platform-node/NodeRuntime",
          "@effect/platform-node/NodeServices",
          "effect/Arbitrary",
          "effect/FileSystem",
          "effect/Path",
          "effect/Stdio",
          "effect/Terminal",
          "effect/cli/Argument",
          "effect/cli/CliError",
          "effect/cli/Command",
          "effect/cli/Flag",
          "effect/http/HttpServer",
          "effect/http/HttpServerRequest",
          "effect/http/HttpServerResponse",
          "effect/net/NetAddress",
          "effect/process/ChildProcess",
          "effect/process/ChildProcessSpawner",
          "effect/rpc/RpcClient",
          "effect/rpc/RpcClientError",
          "effect/rpc/RpcGroup"
        ]
      }
    ]
  },
  "include": [
    "src/**/__tests__/**/*",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "tests/**/*"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
