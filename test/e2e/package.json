{
  "name": "@systemfsoftware/stryker-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "End-to-end lane for the shipped stryker artifact: the packed workspace tarball installed with npm and run in one-shot microVMs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/stryker-js-effect.git",
    "directory": "test/e2e"
  },
  "type": "module",
  "scripts": {
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "test:e2e": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@systemfsoftware/effect-cell-types": "catalog:",
    "@systemfsoftware/effect-microsandbox": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "catalog:",
    "@systemfsoftware/effect-readiness": "catalog:",
    "@systemfsoftware/stryker-e2e-core": "workspace:^",
    "@systemfsoftware/stryker-js": "workspace:^",
    "@systemfsoftware/stryker-js-cli-contract": "workspace:^",
    "@systemfsoftware/stryker-js-plugin-interface": "workspace:^",
    "@systemfsoftware/stryker-js-typescript-checker": "workspace:^",
    "@systemfsoftware/stryker-js-vitest-runner": "workspace:^",
    "@systemfsoftware/trace-spec": "catalog:",
    "@systemfsoftware/trace-taxonomy": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@systemfsoftware/vitest": "catalog:",
    "@systemfsoftware/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "microsandbox": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
