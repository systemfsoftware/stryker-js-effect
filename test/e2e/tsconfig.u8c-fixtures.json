{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@systemfsoftware/tsconfig/bundler/dom/library-monorepo",
    "@systemfsoftware/tsconfig/effect/entrypoint"
  ],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "customConditions": ["@systemfsoftware/source"],
    "types": ["node"]
  },
  "include": [
    "testResources/calc-fixture/stryker.config.ts",
    "testResources/enterprise-monorepo-fixture/stryker.config.ts",
    "testResources/enterprise-monorepo-fixture/stryker.checker.config.ts",
    "testResources/enterprise-monorepo-fixture/stryker.edge.config.ts",
    "testResources/enterprise-monorepo-fixture/stryker.resilience.config.ts",
    "testResources/enterprise-monorepo-fixture/stryker.sabotage.config.ts",
    "testResources/typescript-checker-fixture/stryker.broken-checker.config.ts",
    "testResources/typescript-checker-fixture/stryker.references.config.ts",
    "testResources/typescript-checker-fixture/stryker.vitest.config.ts",
    "testResources/typescript-checker-fixture/stryker.vm.config.ts"
  ]
}
