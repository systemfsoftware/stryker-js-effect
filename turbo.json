{
  "$schema": "https://v2-10-1.turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "githubActionsRemoteBaseRefFallback": true
  },
  "globalPassThroughEnv": [
    "XDG_CACHE_HOME"
  ],
  "tasks": {
    "build": {
      "outputLogs": "new-only",
      "inputs": [
        "src/**",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json",
        "tsdown.config.*",
        "$TURBO_ROOT$/packages/toolchain/tsdown-config/lib/**",
        "$TURBO_ROOT$/packages/toolchain/tsdown-config/package.json"
      ],
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "outputLogs": "errors-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "tsconfig.*.json",
        "$TURBO_ROOT$/packages/toolchain/tsdown-config/lib/**",
        "!**/*.md"
      ],
      "outputs": [],
      "dependsOn": [
        "^build",
        "^api:check",
        "build",
        "api:check"
      ],
      "cache": true
    },
    "//#typecheck:node": {
      "outputLogs": "errors-only",
      "inputs": [
        "tsconfig.node.json",
        "commitlint.config.ts",
        ".lintstagedrc.js"
      ],
      "outputs": [],
      "cache": true
    },
    "//#test:scripts": {
      "outputLogs": "errors-only",
      "inputs": [
        "scripts/**",
        "test/bench/src/turbo-affected.ts",
        "test/bench/src/turbo-affected.schema.ts",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "bin/deno",
        "flake.nix",
        "flake.lock"
      ],
      "outputs": [],
      "cache": true
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.ts",
        "vitest.config.*",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "$TURBO_ROOT$/packages/toolchain/vitest-config/lib/**",
        "!**/README.md",
        "!**/AGENTS.md",
        "!**/CHANGELOG.md",
        "!**/etc/*.api.md"
      ],
      "outputLogs": "errors-only",
      "dependsOn": [
        "^build",
        "^api:check",
        "build",
        "api:check"
      ],
      "outputs": [],
      "env": [
        "NODE_ENV",
        "CI",
        "AGENT"
      ],
      "cache": true
    },
    "@systemfsoftware/stryker-e2e-core#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.ts",
        "vitest.config.*",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "$TURBO_ROOT$/packages/toolchain/vitest-config/lib/**",
        "!**/README.md",
        "!**/AGENTS.md",
        "!**/CHANGELOG.md",
        "!**/etc/*.api.md",
        "$TURBO_ROOT$/test/e2e/tests/**/*.e2e.test.ts",
        "$TURBO_ROOT$/test/e2e/testResources/**",
        "$TURBO_ROOT$/packages/stryker-js-instrumenter/testResources/effect-concurrency/**",
        "$TURBO_ROOT$/pnpm-workspace.yaml"
      ],
      "outputLogs": "errors-only",
      "dependsOn": [
        "^build",
        "^api:check",
        "build",
        "api:check"
      ],
      "outputs": [],
      "env": [
        "NODE_ENV",
        "CI",
        "AGENT"
      ],
      "cache": true
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": [
        "^build"
      ],
      "passThroughEnv": [
        "CI",
        "OTEL_ENABLED",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_SERVICE_NAME"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "oxlint.config.ts",
        "tsconfig.json",
        "tsconfig.*.json",
        "$TURBO_ROOT$/packages/toolchain/oxlint-ignorer-config/lib/**",
        "$TURBO_ROOT$/packages/toolchain/oxlint-ignorer-config/package.json",
        "!**/*.md",
        "!**/etc/*.api.md"
      ],
      "outputs": [],
      "dependsOn": [
        "^build",
        "^api:check",
        "build",
        "api:check"
      ],
      "env": [
        "NODE_ENV",
        "GITHUB_ACTIONS",
        "OXLINT_FORMAT",
        "AGENT"
      ],
      "cache": true
    },
    "attw": {
      "outputLogs": "errors-only",
      "inputs": [
        "dist/**",
        "package.json"
      ],
      "dependsOn": [
        "^build",
        "^api:check",
        "build",
        "api:check"
      ]
    },
    "mutation": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "api:check": {
      "outputLogs": "errors-only",
      "inputs": [
        "src/**",
        "api-extractor.json",
        "api-extractor.*.json",
        "tsconfig.build.json",
        "tsconfig.*.json",
        "etc/*.api.md"
      ],
      "outputs": [
        "etc/*.api.md",
        "temp/**"
      ],
      "dependsOn": [
        "build"
      ]
    },
    "lint:tsgo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "tsconfig.*.json",
        "$TURBO_ROOT$/node_modules/@systemfsoftware/tsconfig/effect.json",
        "$TURBO_ROOT$/node_modules/@systemfsoftware/tsconfig/effect-entrypoint.json",
        "!**/*.md"
      ],
      "outputs": [],
      "env": [
        "TSGO_FORMAT"
      ],
      "cache": true
    }
  }
}
